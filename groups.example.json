        "windows ui",
        "windows app",
        "windows installer",
        "windows update",
        "windows hello",
        "windows search",
        "windows storage",
        "windows wifi",
        "windows bluetooth",
        "windows graphics",
        "windows 11",
        "windows client"
      ],
      "excludes": [
