{
  "_readme": [
    "Product inventory for the report. Copy this file to groups.json and edit",
    "it to match your estate — groups.json is gitignored, so your inventory",
    "never lands in the repository. Without it the values below are used.",
    "",
    "product_groups[].product_filter is optional. Without it a group takes",
    "every CVE its keywords match. With it, a CVE also has to affect one of",
    "the listed products; the names are matched case-insensitively as",
    "substrings against the vendor's product list (MSRC product names read",
    "'Windows 11 Version 23H2 for x64-based Systems'). Findings that carry no",
    "product data at all are kept either way — at Red Hat that is the",
    "majority, and in a security report an uncertain inclusion beats a silent",
    "loss.",
    "",
    "retired_platforms applies across all groups: those entries disappear",
    "from every 'affected' line, and a CVE that affects only such platforms",
    "never enters the report. Use this rather than a product_filter on the",
    "catch-all group — that group is the last stop for anything unmatched, so",
    "filtering it would drop CVEs from the report entirely."
  ],
  "retired_platforms": [
    "windows server 2012",
    "windows 10",
    "rhel 7",
    "rhel 8"
  ],
  "product_groups": [
    {
      "name": "Windows Server",
      "versions": "Windows Server 2019, 2022, 2025",
      "cp_source": "msrc",
      "keywords": [
        "windows server",
        "windows active directory",
        "active directory domain",
        "windows netlogon",
        "windows hyper-v",
        "windows dns",
        "windows deployment",
        "windows remote desktop",
        "windows container"
      ],
      "excludes": [],
      "product_filter": [
        "windows server 2019",
        "windows server 2022",
        "windows server 2025"
      ],
      "search_term": "Patch Tuesday {month} {year} Windows Server CVE",
      "color": "#004578"
    },
    {
      "name": "Windows Client",
      "versions": "Windows 11 24H2, 25H2 (x64)",
      "cp_source": "msrc",
      "keywords": [
        "windows shell",
        "windows gdi",
